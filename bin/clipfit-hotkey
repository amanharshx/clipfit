#!/bin/bash
# clipfit hotkey wrapper.
# Bind a keyboard shortcut to this script (via skhd, Hammerspoon, Raycast,
# Automator Quick Action, etc.). It shrinks the current clipboard image in
# place and shows a macOS notification with the result.
#
# Only images larger than the cap are changed; anything else is left alone.

CLIPFIT_BIN="$(cd "$(dirname "$0")/.." && pwd)/.venv/bin/clipfit"
exec "$CLIPFIT_BIN" --quiet --notify "$@"
