#!/bin/bash
# clipfit hotkey wrapper (for launchers other than skhd, e.g. Hammerspoon,
# Raycast, Automator). `clipfit hotkey set` binds skhd directly to the clipfit
# binary, so this wrapper is optional.
#
# Resolution order: clipfit on PATH (Homebrew/pipx install), then a dev venv
# next to this script.

if command -v clipfit >/dev/null 2>&1; then
    CLIPFIT_BIN="$(command -v clipfit)"
else
    CLIPFIT_BIN="$(cd "$(dirname "$0")/.." && pwd)/.venv/bin/clipfit"
fi

exec "$CLIPFIT_BIN" --quiet --notify --sound "$@"
